decomp/
# Derived from the copyrighted ROM, so it is a local reading aid only and must
docs/tickets/
# generated on demand by tools/ticket_trace.py from /tmp artifacts; big and reproducible
# Ghidra's decompilation of the real cartridge (tools/ghidra_decompile.sh).
# never be committed.  The Ghidra install and its project database live outside
# out of git (only served locally).
.pi/goals/
.pi/.goals-pool-snapshot.json
.pi/npm/
# pi session state (goal ledger, snapshots); .pi/agents, prompts, settings are tracked
__pycache__/
/target
target/
